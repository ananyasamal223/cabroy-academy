PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/rathi_academy
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Rathi Academy <no-reply@rathiacademy.com>
ADMIN_EMAIL=admin@rathiacademy.com
ADMIN_PASSWORD=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Must match VITE_GOOGLE_CLIENT_ID in the frontend
GOOGLE_CLIENT_ID=

# Optional local-only dummy instructor seed; never use a real account password.
SEED_INSTRUCTOR_PASSWORD=

# Hosted storage and email (leave blank to use local disk/SMTP).
UPLOAD_STORAGE=
RESEND_API_KEY=
EMAIL_FROM=
# Set 1 on Render with direct/DNS-only API routing; review if adding proxies.
TRUST_PROXY_HOPS=
